{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"files": {
		"ignore": [
			"node_modules",
			"dist",
			"data",
			"coverage",
			"**/coverage/**",
			".omc",
			"**/.omc/**",
			"**/*.min.js",
			".claude",
			"**/.claude/**"
		]
	},
	"overrides": [
		{
			"include": ["packages/web-ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useButtonType": "off",
						"useKeyWithClickEvents": "off",
						"noSvgWithoutTitle": "off",
						"noLabelWithoutControl": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		}
	]
}
