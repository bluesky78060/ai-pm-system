# APS-1-32: 테스트 전용 DATABASE_URL. 이 파일을 .env.test 로 복사해 값을 채운다.
#
#   cp .env.test.example .env.test && chmod 600 .env.test
#
# 반드시 전용 test 브랜치를 가리켜야 한다. production compute를 넣으면
# context-service.test.ts / services.test.ts 의 PROD_COMPUTE_HOSTS 가드가 차단한다.
# 단 그 가드는 하드코딩된 엔드포인트만 잡으므로, 값은 스스로 확인할 것 (APS-1-25 참조).
#
# .env.test 는 gitignored 다. 절대 커밋하지 말 것.
DATABASE_URL=postgresql://<user>:<password>@<test-branch-compute>.neon.tech/neondb?channel_binding=require&sslmode=require

# APS-1-25: 허용할 테스트 DB 호스트명(쉼표 구분). **필수** — 설정하지 않으면 테스트가 차단된다.
# 모르는 호스트를 기본 차단하는 것이 의도된 동작이다(fail-closed).
# 값은 위 DATABASE_URL의 호스트명과 같아야 한다. 두 번 적는 것이 목적이다 —
# 복붙 한 번으로 프로덕션에 붙는 것을 막기 위해 고의적 행동을 두 번 요구한다.
TEST_DB_ALLOWED_HOSTS=<test-branch-compute>.neon.tech
