{
	"name": "ai-pm-system",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"description": "MCP-based AI autonomous project management system",
	"scripts": {
		"build": "pnpm -r build",
		"dev:mcp": "pnpm --filter @ai-pm/mcp-server dev",
		"dev:ui": "pnpm --filter @ai-pm/web-ui dev",
		"test": "pnpm -r test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"start:api": "node packages/mcp-server/dist/api-server.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"typescript": "^5.6.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "better-sqlite3", "esbuild"],
		"overrides": {
			"hono": ">=4.12.4",
			"@hono/node-server": ">=1.19.10",
			"express-rate-limit": ">=8.2.2",
			"path-to-regexp": ">=8.4.0",
			"express>path-to-regexp": "0.1.12",
			"picomatch": ">=4.0.4",
			"vite": ">=7.3.2",
			"fast-uri": ">=3.1.2"
		}
	}
}
