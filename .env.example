# SQLite database path (default: ./data/pm.db)
DB_PATH=./data/pm.db

# Express HTTP server port (default: 3100)
HTTP_PORT=3100

# GitHub integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Log level (default: info)
LOG_LEVEL=info

# Google Gemini API key (research_with_gemini 도구 사용 시 필수)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# REST API 인증 키 (모든 /api/* 엔드포인트에 필수)
# 생성 예시: openssl rand -hex 32
API_KEY=replace-me-with-secure-random-string

# CORS 허용 Origin (쉼표 구분, 기본값: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,https://ai-pm-system.onrender.com
